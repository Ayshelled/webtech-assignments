<header>
  <nav class="navbar navbar-expand-xl border-bottom" aria-label="Main navigation">
    <div class="container py-2">
      <%= link_to root_path, class: "navbar-brand" do %>Roomies<span class="brand-dot">.</span><% end %>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
              aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="mainNav">
        <ul class="navbar-nav ms-auto align-items-xl-center gap-xl-3">
          <li class="nav-item"><%= nav_link "Search rooms", listings_path, "listings" %></li>
          <li class="nav-item"><%= nav_link "Neighborhoods", neighborhoods_path, "neighborhoods" %></li>
          <% if policy(Amenity).index? %>
            <li class="nav-item"><%= nav_link "Amenities", amenities_path, "amenities" %></li>
          <% end %>
          <% if policy(Report).index? %>
            <li class="nav-item"><%= nav_link "Reports", reports_path, "reports" %></li>
          <% end %>
          <li class="nav-item"><%= nav_link "Properties", properties_path, "properties" %></li>
          <% if authenticated? %>
            <li class="nav-item"><%= nav_link "Applications", applications_path, "applications" %></li>
          <% end %>
          <li class="nav-item"><%= link_to "How it works", root_path(anchor: "how-it-works"), class: "nav-link" %></li>
          <% if authenticated? %>
            <li class="nav-item">
              <%= link_to "Publish a room", new_property_path, class: "btn btn-coral px-3" %>
            </li>
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-person-circle me-1" aria-hidden="true"></i><%= current_user.full_name %>
                <% if current_user.moderator? %><span class="badge text-bg-dark ms-1">Moderator</span><% end %>
              </a>
              <ul class="dropdown-menu dropdown-menu-end">
                <li><%= link_to "My profile", profile_path, class: "dropdown-item" %></li>
                <li><%= link_to "My applications", applications_path, class: "dropdown-item" %></li>
                <li><hr class="dropdown-divider"></li>
                <li><%= button_to "Sign out", session_path, method: :delete, class: "dropdown-item" %></li>
              </ul>
            </li>
          <% else %>
            <li class="nav-item"><%= nav_link "Log in", new_session_path, "sessions" %></li>
            <li class="nav-item">
              <%= link_to "Sign up", sign_up_path, class: "btn btn-coral px-3" %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </nav>
</header>
