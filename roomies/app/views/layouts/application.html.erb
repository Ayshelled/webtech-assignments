<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} | Roomies" : "Roomies | Find your next room" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Roomies helps you find a room and a home that feels right.">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Roomies">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="d-flex flex-column min-vh-100">
    <a class="visually-hidden-focusable btn btn-light position-absolute m-2" href="#main">Skip to content</a>

    <%= render "layouts/navbar" %>

    <main id="main" class="flex-grow-1">
      <%= yield %>
    </main>

    <%= render "layouts/footer" %>
  </body>
</html>
