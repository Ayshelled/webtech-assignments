<% content_for :title, "Applications" %>

<section class="page-header">
  <div class="container">
    <p class="section-label mb-2">Applications</p>
    <h1 class="h2 mb-1"><%= @box == "sent" ? "Applications you sent" : "Your application inbox" %></h1>
    <p class="text-secondary mb-3">
      <%= @box == "sent" ? "The rooms you applied to and where each application stands." :
                           "Applications to your rooms. Shortlist, accept or reject them right here." %>
    </p>

    <ul class="nav nav-tabs mb-3">
      <li class="nav-item">
        <%= link_to "Received", applications_path, class: class_names("nav-link", active: @box == "received"),
                                                   aria: { current: ("page" if @box == "received") } %>
      </li>
      <li class="nav-item">
        <%= link_to "Sent", applications_path(box: "sent"), class: class_names("nav-link", active: @box == "sent"),
                                                             aria: { current: ("page" if @box == "sent") } %>
      </li>
    </ul>

    <% if current_user %>
      <%= render "applications/inbox_summary", box: @box, status: @status, status_counts: @status_counts %>
    <% end %>
  </div>
</section>

<section class="container py-5">
  <% if current_user.nil? %>
    <%= render "shared/empty_state", message: "Choose who you are acting as in the navigation bar to see your applications.",
                                     icon: "person-circle" %>
  <% elsif @applications.any? %>
    <div class="table-responsive detail-panel">
      <table class="table table-hover align-middle mb-0">
        <thead>
          <tr>
            <th scope="col"><%= @box == "received" ? "Seeker" : "Application" %></th>
            <th scope="col">Room</th>
            <th scope="col">Move-in</th>
            <th scope="col">Stay</th>
            <th scope="col">Status</th>
            <th scope="col">Sent</th>
            <th scope="col" class="text-end"><%= @box == "received" ? "Your answer" : "" %></th>
          </tr>
        </thead>
        <tbody>
          <%= render partial: "applications/application_row", collection: @applications, as: :application,
                     locals: { box: @box, status: @status } %>
        </tbody>
      </table>
    </div>
  <% else %>
    <%= render "shared/empty_state", message: "No applications in this state.", icon: "envelope-open" %>
  <% end %>
</section>
