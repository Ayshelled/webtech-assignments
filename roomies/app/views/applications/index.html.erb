<% content_for :title, "Applications" %>

<section class="page-header">
  <div class="container">
    <p class="section-label mb-2">Applications</p>
    <% titles = { "sent" => "Applications you sent", "received" => "Your application inbox", "all" => "Every application" } %>
    <% intros = { "sent"     => "The rooms you applied to and where each application stands.",
                  "received" => "Applications to your rooms. Shortlist, accept or reject them right here.",
                  "all"      => "As a moderator you can see the applications to every room. Only each room's host answers them." } %>
    <h1 class="h2 mb-1"><%= titles[@box] %></h1>
    <p class="text-secondary mb-3"><%= intros[@box] %></p>

    <ul class="nav nav-tabs mb-3">
      <li class="nav-item">
        <%= link_to "Received", applications_path, class: class_names("nav-link", active: @box == "received"),
                                                   aria: { current: ("page" if @box == "received") } %>
      </li>
      <li class="nav-item">
        <%= link_to "Sent", applications_path(box: "sent"), class: class_names("nav-link", active: @box == "sent"),
                                                             aria: { current: ("page" if @box == "sent") } %>
      </li>
      <% if current_user.moderator? %>
        <li class="nav-item">
          <%= link_to "All (moderator)", applications_path(box: "all"), class: class_names("nav-link", active: @box == "all"),
                                                                        aria: { current: ("page" if @box == "all") } %>
        </li>
      <% end %>
    </ul>

    <%= render "applications/inbox_summary", box: @box, status: @status, status_counts: @status_counts %>
  </div>
</section>

<section class="container py-5">
  <% if @applications.any? %>
    <div class="table-responsive detail-panel">
      <table class="table table-hover align-middle mb-0">
        <thead>
          <tr>
            <th scope="col"><%= @box == "sent" ? "Application" : "Seeker" %></th>
            <th scope="col">Room</th>
            <th scope="col">Move-in</th>
            <th scope="col">Stay</th>
            <th scope="col">Status</th>
            <th scope="col">Sent</th>
            <th scope="col" class="text-end"><%= { "received" => "Your answer", "all" => "Status" }[@box] %></th>
          </tr>
        </thead>
        <tbody>
          <%= render partial: "applications/application_row", collection: @applications, as: :application,
                     locals: { box: @box, status: @status } %>
        </tbody>
      </table>
    </div>
  <% else %>
    <%= render "shared/empty_state", message: "No applications in this state.", icon: "envelope-open" %>
  <% end %>
</section>
