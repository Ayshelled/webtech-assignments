<%# Only while the host hasn't decided. Locals: application %>
<% if policy(application).withdraw? && application.awaiting_answer? %>
  <%= button_to "Withdraw application", withdraw_application_path(application), method: :patch,
                class: "btn btn-sm btn-outline-danger w-100",
                form: { data: { turbo_confirm: "Withdraw your application? You won't be able to apply to this room again." } } %>
<% end %>
