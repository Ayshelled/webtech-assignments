<% content_for :title, "Edit your review" %>
<%= render "shared/form_header", title: "Edit your review", back_label: @property.street_address,
           back_path: property_path(@property) %>

<div class="container py-5">
  <div class="row">
    <div class="col-lg-8">
      <div class="detail-panel p-4">
        <%= render "reviews/form", review: @review, url: review_path(@review), visits: [] %>
        <%= link_to "Cancel", property_path(@property), class: "btn btn-outline-secondary mt-2" %>
      </div>
    </div>
  </div>
</div>
