<%# What the host (or a moderator) can do from the listing page. The lifecycle buttons change
    with the listing's state (Listing::TRANSITIONS) and with ListingPolicy; ListingsController
    asks the policy again, so hiding a button is only a courtesy. Locals: listing %>
<% listing_policy = policy(listing) %>
<% if listing_policy.update? || listing_policy.destroy? %>
  <% hints = {
       "draft"     => "This room is a draft: only you can see it. Publish it so seekers can find it and apply.",
       "published" => "This room is published: seekers can find it and apply.",
       "reserved"  => "You accepted an applicant. Mark the room as rented once your new housemate has moved in.",
       "rented"    => "This room is rented.",
       "withdrawn" => "This room is withdrawn: it doesn't show in the search nor take applications."
     } %>
  <div class="detail-panel p-3 mb-4">
    <% if listing_policy.publish? %>
      <p class="small mb-2"><i class="bi bi-info-circle me-1" aria-hidden="true"></i><%= hints[listing.status] %></p>
    <% else %>
      <p class="small mb-2"><i class="bi bi-shield-check me-1" aria-hidden="true"></i>You are moderating this room (it is <%= listing.status %>).</p>
    <% end %>
    <div class="d-flex flex-wrap gap-2">
      <% if listing_policy.publish? && listing.can_change_to?(:published) %>
        <%= button_to listing.withdrawn? ? "Publish again" : "Publish", publish_listing_path(listing), method: :patch,
                      class: "btn btn-sm btn-coral" %>
      <% end %>
      <% if listing_policy.mark_rented? && listing.can_change_to?(:rented) %>
        <%= button_to "Mark as rented", mark_rented_listing_path(listing), method: :patch, class: "btn btn-sm btn-success",
                      form: { data: { turbo_confirm: "Has your new housemate moved in? The room will be marked as rented." } } %>
      <% end %>
      <% if listing_policy.withdraw? && listing.can_change_to?(:withdrawn) %>
        <%= button_to "Withdraw", withdraw_listing_path(listing), method: :patch, class: "btn btn-sm btn-outline-dark",
                      form: { data: { turbo_confirm: "Withdraw this room? It will stop taking applications." } } %>
      <% end %>
      <%= link_to "Edit listing", edit_listing_path(listing), class: "btn btn-sm btn-outline-secondary" %>
      <% if listing_policy.see_applications? && (listing.published? || listing.reserved?) %>
        <%= link_to "See the applications", applications_path(box: (listing_policy.publish? ? "received" : "all")),
                    class: "btn btn-sm btn-outline-secondary" %>
      <% end %>
      <%= button_to "Delete listing", listing_path(listing), method: :delete, class: "btn btn-sm btn-outline-danger",
                    form: { data: { turbo_confirm: "Delete this listing and all its applications?" } } %>
    </div>
  </div>
<% end %>
