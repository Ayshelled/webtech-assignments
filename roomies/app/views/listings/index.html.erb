<% content_for :title, "Search rooms" %>

<%# The first render comes from the server. After that, changing a filter asks the
    public JSON API (/api/v1/listings) with fetch and redraws only the results
    (listing_search_controller.js). Without JavaScript the form still works as a GET. %>
<div data-controller="listing-search"
     data-listing-search-url-value="<%= api_v1_listings_path %>"
     data-action="submit->listing-search#search change->listing-search#search">
  <section class="page-header">
    <div class="container">
      <p class="section-label mb-2">Search rooms</p>
      <h1 class="h2 mb-4">Rooms open for applications</h1>
      <%= render "listings/search_form", neighborhoods: @neighborhoods, amenities: @amenities, filters: @filters %>
    </div>
  </section>

  <section class="container py-5" aria-label="Results">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-4">
      <p class="mb-0 text-secondary" aria-live="polite">
        <span data-listing-search-target="count"><%= pluralize(@listings.size, "room") %> found</span>
        <span class="small ms-2" data-listing-search-target="status"></span>
      </p>
      <%= link_to "Clear filters", listings_path, class: "btn btn-sm btn-outline-secondary" %>
    </div>

    <div data-listing-search-target="results">
      <% if @listings.any? %>
        <div class="row g-4">
          <%= render partial: "listings/listing", collection: @listings, as: :listing %>
        </div>
      <% else %>
        <%= render "shared/empty_state", message: "No published rooms match these filters. Try widening your search.", icon: "search" %>
      <% end %>
    </div>
    <div class="text-center mt-4" data-listing-search-target="more"></div>
  </section>
</div>
