<%# What the host (or a moderator) can do from the property page. Locals: property
    The buttons are a courtesy: PropertiesController and ListingsController ask the policies again. %>
<% property_policy = policy(property) %>
<% if property_policy.add_listing? || property_policy.update? || property_policy.destroy? %>
  <div class="d-flex flex-wrap gap-2 mt-3">
    <% if property_policy.add_listing? %>
      <%= link_to new_property_listing_path(property), class: "btn btn-sm btn-coral" do %>
        <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add a room
      <% end %>
    <% end %>
    <% if property_policy.update? %>
      <%= link_to "Edit property", edit_property_path(property), class: "btn btn-sm btn-outline-secondary" %>
    <% end %>
    <% if property_policy.destroy? %>
      <%= button_to "Delete property", property_path(property), method: :delete, class: "btn btn-sm btn-outline-danger",
                    form: { data: { turbo_confirm: "Delete this property and all its listings, applications and reviews?" } } %>
    <% end %>
  </div>
<% end %>
