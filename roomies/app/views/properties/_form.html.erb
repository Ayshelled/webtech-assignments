<%# Locals: property. Uses @neighborhoods, @amenity_options and @shared_space_options from the controller %>
<%= form_with model: property, class: "detail-panel p-4" do |f| %>

  <div class="row g-3">
    <div class="col-12">
      <%= f.label :street_address, class: "form-label" %>
      <%= f.text_field :street_address, class: field_class(f, :street_address), required: true, maxlength: 200,
                                        placeholder: "e.g. Av. Irarrázaval 2450, depto 304" %>
      <%= field_errors(f, :street_address) %>
    </div>

    <div class="col-md-6">
      <%= f.label :neighborhood_id, "Neighborhood", class: "form-label" %>
      <%= f.collection_select :neighborhood_id, @neighborhoods, :id, :name, { prompt: "Choose a neighborhood" },
                              class: field_class(f, :neighborhood_id, :neighborhood, base: "form-select"), required: true %>
      <%= field_errors(f, :neighborhood_id, :neighborhood) %>
    </div>

    <div class="col-md-6">
      <%= f.label :property_type, class: "form-label" %>
      <%= f.select :property_type, Property.property_types.keys.map { |type| [type.humanize, type] },
                   { prompt: "Choose a type" }, class: field_class(f, :property_type, base: "form-select"), required: true %>
      <%= field_errors(f, :property_type) %>
    </div>

    <div class="col-md-6">
      <%= f.label :bedrooms_count, "Bedrooms", class: "form-label" %>
      <%= f.number_field :bedrooms_count, class: field_class(f, :bedrooms_count), required: true, min: 1, max: 20, step: 1 %>
      <%= field_errors(f, :bedrooms_count) %>
    </div>

    <div class="col-md-6">
      <%= f.label :bathrooms_count, "Bathrooms", class: "form-label" %>
      <%= f.number_field :bathrooms_count, class: field_class(f, :bathrooms_count), required: true, min: 1, max: 20, step: 1 %>
      <%= field_errors(f, :bathrooms_count) %>
    </div>

    <%# Both groups are the same amenity_ids array: only the first sends the hidden empty value,
        so unchecking everything clears the amenities %>
    <fieldset class="col-md-6">
      <legend class="form-label">Amenities</legend>
      <div>
        <%= f.collection_check_boxes :amenity_ids, @amenity_options, :id, :name do |b| %>
          <div class="form-check">
            <%= b.check_box class: "form-check-input" %>
            <%= b.label class: "form-check-label" %>
          </div>
        <% end %>
      </div>
    </fieldset>

    <fieldset class="col-md-6">
      <legend class="form-label">Shared spaces</legend>
      <div>
        <%= f.collection_check_boxes :amenity_ids, @shared_space_options, :id, :name, include_hidden: false do |b| %>
          <div class="form-check">
            <%= b.check_box class: "form-check-input" %>
            <%= b.label class: "form-check-label" %>
          </div>
        <% end %>
      </div>
    </fieldset>
  </div>
  <p class="form-text mb-0 mt-2">
    Missing something? <%= link_to "Add it to the catalog", new_amenity_path %>.
  </p>

  <div class="d-flex gap-2 mt-4">
    <%= f.submit property.persisted? ? "Save changes" : "Register property", class: "btn btn-coral" %>
    <%= link_to "Cancel", property.persisted? ? property_path(property) : properties_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
